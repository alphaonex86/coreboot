# SeaBIOS for the IBM Aptiva 2168 (Type I-2): the base settings; the shared seabios.config and the board's
# boards/aptiva2168/seabios.config follow (last assignment wins). No board code yet (port step 5).
CONFIG_COREBOOT=y
# CONFIG_QEMU is not set
# CONFIG_CSM is not set
CONFIG_THREADS=y
CONFIG_RELOCATE_INIT=y
CONFIG_BOOTMENU=y
# CONFIG_BOOTSPLASH is not set
CONFIG_BOOTORDER=y
CONFIG_HOST_BIOS_GEOMETRY=y
# CONFIG_MULTIBOOT is not set
# CONFIG_ENTRY_EXTRASTACK is not set
CONFIG_ROM_SIZE=0
CONFIG_ATA=y
CONFIG_ATA_PIO32=y
# CONFIG_SDCARD is not set
# CONFIG_MEGASAS is not set
# CONFIG_FLASH_FLOPPY is not set
# CONFIG_NVME is not set
CONFIG_PS2PORT=y
CONFIG_SERIAL=y
# CONFIG_SERCON is not set
CONFIG_LPT=y
CONFIG_RTC_TIMER=y
CONFIG_HARDWARE_IRQ=y
# CONFIG_PMTIMER is not set
# CONFIG_TSC_TIMER is not set
CONFIG_DRIVES=y
CONFIG_CDROM_BOOT=y
CONFIG_CDROM_EMU=y
CONFIG_PCIBIOS=y
CONFIG_APMBIOS=y
CONFIG_OPTIONROMS=y
CONFIG_PMM=y
CONFIG_BOOT=y
CONFIG_KEYBOARD=y
# CONFIG_KBD_CALL_INT15_4F is not set
# CONFIG_S3_RESUME is not set
# CONFIG_VGAHOOKS is not set
# CONFIG_DISABLE_A20 is not set
CONFIG_NO_VGABIOS=y
CONFIG_DEBUG_LEVEL=0
# CONFIG_DEBUG_COREBOOT is not set
# CONFIG_NEWBIOS_BOARD_MB8433 is not set
CONFIG_NEWBIOS_BOARD_GENERIC=y
